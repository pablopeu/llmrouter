[Unit]
Description=LLMRouter local LiteLLM proxy
After=network.target

[Service]
Type=exec
WorkingDirectory=%h/llmrouter
EnvironmentFile=-%h/llmrouter/.env
ExecStart=%h/llmrouter/.venv/bin/python %h/llmrouter/routerctl.py run
Restart=on-failure
RestartSec=3
TimeoutStopSec=120
KillMode=mixed
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
